# Скопировать в ~/.config/kino/config.env (chmod 600). В репо не коммитить.

# TMDB — обязателен. v4 Read Access Token со страницы https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# OMDb — опционально, обогащение IMDb/Metacritic/RT. 1000 запросов/сутки.
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# kinopoisk.dev — опционально, RU-рейтинг и watchability. 200 запросов/сутки на free.
# Токен через telegram-бота @kinopoiskdev_bot
KINOPOISK_API_KEY=

# Дефолты
KINO_REGION=US
KINO_LANG=ru-RU
KINO_DB=
